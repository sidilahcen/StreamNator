<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="12dp" android:layout_marginBottom="8dp"
    android:focusable="true" android:focusableInTouchMode="true"
    android:background="@drawable/focus_border" android:clickable="true">
    <TextView android:id="@+id/playlist_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold"/>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="4dp">
        <TextView android:id="@+id/playlist_type" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="#E50914" android:layout_marginEnd="12dp"
            android:fontFamily="sans-serif-medium"/>
        <TextView android:id="@+id/playlist_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="#888888"/>
    </LinearLayout>
</LinearLayout>